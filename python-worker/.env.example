# Copy this file to `python-worker/.env` and fill in your own values.
# `.env` is gitignored — never commit real credentials.

# ─────────────────────────────────────────────────────────────────────────────
# Vision provider (required)
# ─────────────────────────────────────────────────────────────────────────────
# The worker sends uploaded photos to a vision model to detect the item's
# category, colours and attributes. Get your own free key at:
#   https://build.nvidia.com/  ->  pick a model  ->  "Get API Key"
# Keys look like: nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_API_KEY=your-nvidia-api-key-here

# Any vision-capable model available on your account.
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# ─────────────────────────────────────────────────────────────────────────────
# Database (required)
# ─────────────────────────────────────────────────────────────────────────────
# MUST point at the same database as backend/.env — the backend creates upload
# jobs and the worker polls for them. If these two disagree, uploads stay stuck
# on the "Uncategorized" placeholder forever because the worker never sees them.
#
# Percent-encode special characters in the password (@ -> %40, : -> %3A).
DATABASE_URL=postgresql://user:password@localhost:5432/jewelvault
