# Copy this file to `app_config.env` (that exact name — it is loaded as a
# Flutter asset in pubspec.yaml and is gitignored).

# Base URL of the backend API, including the /api/v1 prefix.
# The port must match PORT in backend/.env (default 5000).
#
#   Desktop / web / iOS simulator:   http://localhost:5000/api/v1
#   Android emulator:                http://10.0.2.2:5000/api/v1
#   Physical device on your LAN:     http://<your-computer-ip>:5000/api/v1
#   Deployed backend:                https://your-api-host/api/v1
API_BASE_URL=http://localhost:5000/api/v1
