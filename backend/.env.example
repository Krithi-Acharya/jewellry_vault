# Copy this file to `backend/.env` and fill in your own values.
# `.env` is gitignored — never commit real credentials.

# ─────────────────────────────────────────────────────────────────────────────
# Database (required)
# ─────────────────────────────────────────────────────────────────────────────
# Postgres connection string used by Prisma.
#   Local:  postgresql://postgres:yourpassword@localhost:5432/jewelvault
#   Remote: postgresql://youruser:yourpassword@your-db-host:5432/jewel_vault
#
# Special characters in the password MUST be percent-encoded:
#   @ -> %40    : -> %3A    / -> %2F    # -> %23
# e.g. the password "p@ss:word" becomes "p%40ss%3Aword".
DATABASE_URL="postgresql://user:password@localhost:5432/jewelvault"

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
# Port the API listens on. If you change this, update API_BASE_URL in the
# Flutter app's `app_config.env` to match, or the app cannot reach the backend.
PORT=5000

NODE_ENV=development

# Allowed CORS origins. `*` allows any (fine for local dev).
# For a deployed environment, set an explicit origin instead.
CORS_ORIGIN=*

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Admin (required for authenticated routes)
# ─────────────────────────────────────────────────────────────────────────────
# Not set here — the backend reads a `service-account.json` file placed in the
# `backend/` directory (gitignored). To get your own:
#   Firebase Console -> Project settings -> Service accounts
#   -> "Generate new private key" -> save as backend/service-account.json
# Without it the server still starts, but every authenticated route will
# reject requests.
