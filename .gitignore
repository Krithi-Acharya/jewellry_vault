# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment / secrets — real config is never committed, only *.example files
.env
*.env
*.env.bak
*.env.*
app_config.env
!.env.example
!app_config.env.example

# Uploaded user content (never commit)
backend/public/uploads/

# Python worker
venv/
.venv/
__pycache__/
python-worker/temp/
python-worker/legacy/
